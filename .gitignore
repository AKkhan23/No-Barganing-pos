frontend/.env.*

# Environment files (local only - keep .env.example committed)
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db

# Cache
.cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
*.swc

# IDE
*.sublime-project
*.sublime-workspace

# Misc
*.pem
.vercel
